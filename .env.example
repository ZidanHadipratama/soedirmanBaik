# local works without cloud credentials. Never use local disk storage on Vercel.
DATA_BACKEND=local
APP_URL=http://localhost:3000
# Generated by npm run setup:local. Required on a hosted deployment.
SESSION_SECRET=
ADMIN_PASSWORD=

# Set DATA_BACKEND=supabase after applying supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
